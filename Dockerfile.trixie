# trixie 变体：运行时是 Debian trixie（glibc），与 Dockerfile.alpine（musl）互为独立变体。
# 前端（Node）和后端（Go）依旧都在容器内编译，宿主机只需要有 docker。
#
# 为什么构建阶段仍用 Alpine：Go 侧是 CGO + 全静态链接的二进制，用 musl 工具链编译出来
# 是真正自包含的（DNS 解析等都不依赖运行时库）；反过来若用 glibc 做静态链接，运行时的
# DNS 解析要靠 dlopen，反而容易出现解析失败。所以这里只把**运行时**换成 Debian，
# 二进制本身与 alpine 变体一致，两个变体各自独立构建、互不共享产物。
#
# 用法见同目录的 build-image.sh（--variant trixie）。

# ---------------------------------------------------------------- 前端
FROM node:24-alpine AS frontend

ARG VERSION=dev
ARG NPM_REGISTRY=https://registry.npmjs.org

WORKDIR /build/web

RUN npm install -g pnpm --registry=${NPM_REGISTRY}

# 先只拷贝依赖清单，依赖没变时可以复用这一层缓存；带上 lockfile 以保证装到同样的版本。
# pnpm-workspace.yaml 也必须带上：里面的 minimumReleaseAgeExclude 是 pnpm 的发布年龄策略豁免，
# 缺了它 pnpm 会以 ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION 拒绝按 lockfile 安装。
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./

# pnpm 10+ 默认不执行依赖包自带的 build 脚本（esbuild 等会因此报 ERR_PNPM_IGNORED_BUILDS），
# 这些脚本对构建产物没有影响，用 --ignore-scripts 安装即可。
# BuildKit 缓存挂载用于保留 pnpm store：重复构建和失败重试都不用重新下载。
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --ignore-scripts --registry=${NPM_REGISTRY}

COPY web/ ./

# 清掉本机残留的前端产物，避免 Vite 把旧的 build/index.html 当成输入
RUN rm -rf build

# Vite 在构建时把 import.meta.env.VITE_* 静态替换进产物，这里注入版本号（对应页脚的显示）
RUN VITE_APP_VERSION="${VERSION}" pnpm run build

# ---------------------------------------------------------------- 后端
FROM golang:1.27-alpine AS backend

ARG VERSION=dev
# Go 模块代理：默认走局域网里的 Athens 缓存代理（实测冷缓存拉全依赖约 10 秒）。
# 可用 --build-arg GOPROXY=... 覆盖；传空字符串则回落到 Go 自带的 proxy.golang.org。
ARG GOPROXY=http://192.168.2.12:50100,direct
ARG APK_PROXY=""
ARG APT_PROXY=""

ENV GO111MODULE=on \
    CGO_ENABLED=1 \
    GOOS=linux \
    GOPROXY=${GOPROXY}

WORKDIR /build

# 把包管理器指向缓存代理：Alpine 改写 /etc/apk/repositories，Debian 系写 apt 的 http 代理配置。
# 这类代理（如 soulteary/apt-proxy）是把上游域名拼进 path 的反向代理，不是通用前向代理，
# 而且 Alpine 默认仓库是 https（前向代理不支持 CONNECT），所以必须改写仓库地址。
# APK_PROXY / APT_PROXY 为空时这一步不做任何事。
RUN if [ -f /etc/apk/repositories ] && [ -n "${APK_PROXY}" ]; then \
      sed -i "s|^https\?://|${APK_PROXY}/|" /etc/apk/repositories; \
    fi; \
    if [ -d /etc/apt/apt.conf.d ] && [ -n "${APT_PROXY}" ]; then \
      printf 'Acquire::http::Proxy "%s";\n' "${APT_PROXY}" > /etc/apt/apt.conf.d/99proxy; \
    fi

# go-sqlite3 依赖 CGO，alpine 下需要 gcc 等工具链
RUN apk add --no-cache build-base

# 依赖单独一层：go.mod / go.sum 不变时可以复用构建缓存；
# 缓存挂载让已下载的模块在重复构建/失败重试之间保留下来。
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

COPY . .
# main.go 里的 //go:embed web/build 需要前端产物
COPY --from=frontend /build/web/build ./web/build

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags "-s -w -X 'message-pusher/common.Version=${VERSION}' -extldflags '-static'" -o message-pusher

# ---------------------------------------------------------------- 运行时（Debian trixie）
FROM debian:trixie-slim

ARG VERSION=dev
ARG APK_PROXY=""
ARG APT_PROXY=""
LABEL org.opencontainers.image.title="message-pusher" \
      org.opencontainers.image.version="${VERSION}"

ENV PORT=3000 \
    TZ=Asia/Shanghai

# 同构建阶段：让运行时的包安装也走缓存代理（本阶段只有 apt）
RUN if [ -d /etc/apt/apt.conf.d ] && [ -n "${APT_PROXY}" ]; then \
      printf 'Acquire::http::Proxy "%s";\n' "${APT_PROXY}" > /etc/apt/apt.conf.d/99proxy; \
    fi

# Debian 官方镜像不带证书与时区数据；用 -trixie-slim 保持体积
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=backend /build/message-pusher /
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/message-pusher"]
